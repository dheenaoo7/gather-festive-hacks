# Copy to .env.local (git-ignored) or set each with: npm run key -- NAME
SARVAM_API_KEY=
# Public URL phones and webhooks reach (Cloudflare tunnel or deploy)
PUBLIC_URL=
# Flagsmith: client-side environment key (public) and admin key (server only)
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=
FLAGSMITH_ADMIN_KEY=
FLAGSMITH_PROJECT_ID=
# Bolna: phone calls; the agent uses Sarvam STT, LLM and TTS via your Sarvam key
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# NudgeBee API token (sk-nb-...) for nbctl and the workflow webhook
NUDGEBEE_API_KEY=
