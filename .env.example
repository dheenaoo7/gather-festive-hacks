# Copy to .env.local (git-ignored) or set each with: npm run key -- NAME
SARVAM_API_KEY=
# Public URL phones and webhooks reach (Cloudflare tunnel or deploy)
PUBLIC_URL=
# Flagsmith client-side environment key (Project > SDK keys)
NEXT_PUBLIC_FLAGSMITH_ENV_KEY=
# NudgeBee API token (sk-nb-...) for nbctl and the workflow webhook
NUDGEBEE_API_KEY=
